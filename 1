-- MODULE 7: MAIN EXECUTION LOOP (Dormant until Config.Active becomes true)
-- ============================================================================
task.spawn(function()
    while true do
        Services.RunService.Heartbeat:Wait()
        
        if Config.Active then
            ApexEngine:ResolveTargets()
            
            -- Hammer Burst: 15 to 25 remote transmissions per tick
            local burstCount = math.random(15, 25)
            for i = 1, burstCount do
                if not Config.Active then break end
                ApexEngine:FirePayloads()
            end
            
            -- Mandatory Real Cooldown (0.5 - 0.7s) to form the "Hammer then Freeze" rhythm
            local cooldown = math.random(50, 70) / 100
            if Config.FullFreezeActive then
                cooldown = 0.02
            end
            task.wait(cooldown)
        end
    end
end)

